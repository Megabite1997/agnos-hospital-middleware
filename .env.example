# Copy to .env and change the secrets before running `docker compose up`.
POSTGRES_USER=hospital
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hospital_middleware

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_TTL=24h
HIS_TIMEOUT=5s

# Host port Nginx is published on.
NGINX_PORT=8080
